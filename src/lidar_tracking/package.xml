<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>lidar_tracking</name>
  <version>0.1.0</version>
  <description>激光雷达循迹ROS2包,用于小车自动沿着锥桶路线行驶</description>
  <maintainer email="your_email@example.com">zyh</maintainer>
  <license>MIT</license>

  <!-- 继续保留 ament_cmake，避免改变现有 package/launch 组织方式 -->
  <buildtool_depend>ament_cmake</buildtool_depend>

  <!-- C++ arcfit 节点构建依赖（独立可执行文件 lidar_tracking_arcfit） -->
  <build_depend>rclcpp</build_depend>
  <build_depend>sensor_msgs</build_depend>
  <build_depend>geometry_msgs</build_depend>
  <exec_depend>rclcpp</exec_depend>

  <!-- Python 节点运行依赖 -->
  <exec_depend>rclpy</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>

  <!-- 保留原包已有运行依赖，避免现有 launch/包内文件受影响 -->
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>launch_ros</exec_depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
